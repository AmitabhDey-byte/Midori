<mujoco model="Midori_12_servo_prototype">
  <!--
    MIDORI - 12-SERVO PROTOTYPE MODEL
    Assumption: 3 independently actuated revolute joints per leg:
      1) hip abduction/adduction (axis X)
      2) hip pitch (axis Y)
      3) knee pitch (axis Y)

    This is a kinematic/physics prototype, NOT yet an exact digital twin of
    the Printed Bots kit. Dimensions, servo mount orientation, joint axes,
    limits, mass, and actuator strength are provisional until checked against
    the product's assembly photos/CAD/manual.

    Coordinate convention: X = front/back, Y = left/right, Z = up.
    Lengths in metres; joint angles in radians.
  -->
  <compiler angle="radian"/>

  <option integrator="implicitfast"/>

  <size njmax="500" nconmax="150"/>

  <default>
    <joint armature="0.006" damping="0.12" limited="true"/>
    <geom friction="0.9 0.02 0.002" solref="0.01"/>
    <general ctrlrange="-0.7 0.7" ctrllimited="true" forcelimited="true" forcerange="-0.25 0.25" input="pos" biastype="affine" gainprm="4" biasprm="0 -4 -0.15"/>
  </default>

  <worldbody>
    <geom name="floor" size="2 2 0.1" type="plane" rgba="0.78 0.8 0.83 1"/>
    <light name="top_light" pos="0 -1 2" diffuse="0.8 0.8 0.8"/>
    <body name="chassis" pos="0 0 0.15">
      <joint name="root" type="free" armature="0" damping="0"/>
      <geom name="chassis_geom" size="0.065 0.045 0.012" type="box" rgba="0.18 0.35 0.55 1" mass="0.18"/>
      <body name="front_left_hip_abduction" pos="0.048 0.035 0">
        <joint name="front_left_hip_abduction_joint" range="-0.45 0.45" axis="1 0 0"/>
        <geom name="front_left_hip_mount" size="0.008 0.009" pos="0 0.009 0" quat="0.707107 0.707107 0 0" type="capsule" rgba="0.85 0.55 0.18 1" mass="0.012"/>
        <body name="front_left_upper_leg" pos="0 0.018 0">
          <joint name="front_left_hip_pitch_joint" range="-0.8 0.8" axis="0 1 0"/>
          <geom name="front_left_upper_leg_geom" size="0.009 0.0275" pos="0 0 -0.0275" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.025"/>
          <body name="front_left_lower_leg" pos="0 0 -0.055">
            <joint name="front_left_knee_pitch_joint" range="-1.2 1.2" axis="0 1 0"/>
            <geom name="front_left_lower_leg_geom" size="0.008 0.0325" pos="0 0 -0.0325" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.02"/>
            <geom name="front_left_foot" size="0.012" pos="0 0 -0.065" rgba="0.12 0.12 0.12 1" mass="0.008"/>
          </body>
        </body>
      </body>
      <body name="front_right_hip_abduction" pos="0.048 -0.035 0">
        <joint name="front_right_hip_abduction_joint" range="-0.45 0.45" axis="1 0 0"/>
        <geom name="front_right_hip_mount" size="0.008 0.009" pos="0 -0.009 0" quat="0.707107 -0.707107 0 0" type="capsule" rgba="0.85 0.55 0.18 1" mass="0.012"/>
        <body name="front_right_upper_leg" pos="0 -0.018 0">
          <joint name="front_right_hip_pitch_joint" range="-0.8 0.8" axis="0 1 0"/>
          <geom name="front_right_upper_leg_geom" size="0.009 0.0275" pos="0 0 -0.0275" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.025"/>
          <body name="front_right_lower_leg" pos="0 0 -0.055">
            <joint name="front_right_knee_pitch_joint" range="-1.2 1.2" axis="0 1 0"/>
            <geom name="front_right_lower_leg_geom" size="0.008 0.0325" pos="0 0 -0.0325" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.02"/>
            <geom name="front_right_foot" size="0.012" pos="0 0 -0.065" rgba="0.12 0.12 0.12 1" mass="0.008"/>
          </body>
        </body>
      </body>
      <body name="rear_left_hip_abduction" pos="-0.048 0.035 0">
        <joint name="rear_left_hip_abduction_joint" range="-0.45 0.45" axis="1 0 0"/>
        <geom name="rear_left_hip_mount" size="0.008 0.009" pos="0 0.009 0" quat="0.707107 0.707107 0 0" type="capsule" rgba="0.85 0.55 0.18 1" mass="0.012"/>
        <body name="rear_left_upper_leg" pos="0 0.018 0">
          <joint name="rear_left_hip_pitch_joint" range="-0.8 0.8" axis="0 1 0"/>
          <geom name="rear_left_upper_leg_geom" size="0.009 0.0275" pos="0 0 -0.0275" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.025"/>
          <body name="rear_left_lower_leg" pos="0 0 -0.055">
            <joint name="rear_left_knee_pitch_joint" range="-1.2 1.2" axis="0 1 0"/>
            <geom name="rear_left_lower_leg_geom" size="0.008 0.0325" pos="0 0 -0.0325" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.02"/>
            <geom name="rear_left_foot" size="0.012" pos="0 0 -0.065" rgba="0.12 0.12 0.12 1" mass="0.008"/>
          </body>
        </body>
      </body>
      <body name="rear_right_hip_abduction" pos="-0.048 -0.035 0">
        <joint name="rear_right_hip_abduction_joint" range="-0.45 0.45" axis="1 0 0"/>
        <geom name="rear_right_hip_mount" size="0.008 0.009" pos="0 -0.009 0" quat="0.707107 -0.707107 0 0" type="capsule" rgba="0.85 0.55 0.18 1" mass="0.012"/>
        <body name="rear_right_upper_leg" pos="0 -0.018 0">
          <joint name="rear_right_hip_pitch_joint" range="-0.8 0.8" axis="0 1 0"/>
          <geom name="rear_right_upper_leg_geom" size="0.009 0.0275" pos="0 0 -0.0275" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.025"/>
          <body name="rear_right_lower_leg" pos="0 0 -0.055">
            <joint name="rear_right_knee_pitch_joint" range="-1.2 1.2" axis="0 1 0"/>
            <geom name="rear_right_lower_leg_geom" size="0.008 0.0325" pos="0 0 -0.0325" type="capsule" rgba="0.2 0.65 0.45 1" mass="0.02"/>
            <geom name="rear_right_foot" size="0.012" pos="0 0 -0.065" rgba="0.12 0.12 0.12 1" mass="0.008"/>
          </body>
        </body>
      </body>
    </body>
  </worldbody>

  <actuator>
    <general name="front_left_hip_abduction_motor" joint="front_left_hip_abduction_joint"/>
    <general name="front_left_hip_pitch_motor" joint="front_left_hip_pitch_joint"/>
    <general name="front_left_knee_pitch_motor" joint="front_left_knee_pitch_joint"/>
    <general name="front_right_hip_abduction_motor" joint="front_right_hip_abduction_joint"/>
    <general name="front_right_hip_pitch_motor" joint="front_right_hip_pitch_joint"/>
    <general name="front_right_knee_pitch_motor" joint="front_right_knee_pitch_joint"/>
    <general name="rear_left_hip_abduction_motor" joint="rear_left_hip_abduction_joint"/>
    <general name="rear_left_hip_pitch_motor" joint="rear_left_hip_pitch_joint"/>
    <general name="rear_left_knee_pitch_motor" joint="rear_left_knee_pitch_joint"/>
    <general name="rear_right_hip_abduction_motor" joint="rear_right_hip_abduction_joint"/>
    <general name="rear_right_hip_pitch_motor" joint="rear_right_hip_pitch_joint"/>
    <general name="rear_right_knee_pitch_motor" joint="rear_right_knee_pitch_joint"/>
  </actuator>
</mujoco>
