<mujoco model="Printed_Bots_quadruped_spider_12servo_approx">
  <!--
    Visual model uses the supplied body, coxa, femur, hinge, and pointed tibia
    STL meshes. CAD body parts share one frame; leg parts are placed on articulated
    links using estimated pivots and orientations. Collision proxies remain simple
    boxes, capsules, and hidden toe contacts, so this is still not a calibrated
    digital twin. Confirm servo zeroes, stops, and clearances before hardware use.

    Each leg has a coxa/yaw joint, femur/pitch joint, and tibia/knee joint.
    Existing joint and actuator names are kept for compatibility with
    control_test.py. Coordinates: X forward, Y left, Z up; lengths in metres.
  -->
  <compiler angle="radian" autolimits="true"/>
  <option timestep="0.002" gravity="0 0 -9.81" integrator="implicitfast"/>
  <size njmax="800" nconmax="300"/>

  <default>
    <joint damping="0.12" armature="0.006" limited="true"/>
    <!-- Decorative printed/servo details should not collide with moving links. -->
    <geom condim="3" friction="0.9 0.02 0.002" solref="0.01 1" solimp="0.9 0.95 0.001" contype="0" conaffinity="0"/>
    <default class="contact">
      <geom contype="1" conaffinity="1"/>
    </default>
    <!-- Virtual servo tuning improves target tracking in the visual simulator.
         Measure the real servos before using these limits for hardware. -->
    <position kp="10" kv="0.5" ctrllimited="true" ctrlrange="-1.5 1.5" forcelimited="true" forcerange="-0.45 0.45"/>
  </default>

  <asset>
    <!-- Supplied printed parts, kept as articulated visual geometry. -->
    <mesh name="printed_body_lower" file="assets/body-d.stl" scale="0.001 0.001 0.001"/>
    <mesh name="printed_body_upper" file="assets/body-u.stl" scale="0.001 0.001 0.001"/>
    <mesh name="printed_body_middle" file="assets/body-m.stl" scale="0.001 0.001 0.001"/>
